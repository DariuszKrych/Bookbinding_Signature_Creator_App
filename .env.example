# Settings for "Generate book for printing with AI". Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is git-ignored and docker-ignored. It is for running the app on your own
# machine and nothing else.
#
# ---------------------------------------------------------------------------
# On Render, there is no `.env` file at all.
# ---------------------------------------------------------------------------
# Render builds the image from the public repository, so anything committed is
# public. The key therefore never goes near the repository. Instead:
#
#   Render dashboard -> your service -> Environment -> Add Environment Variable
#       Key:   OPENROUTER_API_KEY
#       Value: sk-or-v1-...
#
# Render injects it into the container's environment at run time, separately
# from the git pull, and `os.environ` already holds it before the app starts.
# Put it in "Environment Variables", never in a Docker build argument: build
# arguments are recorded in the image history and can be read back out.
#
# The app reads a `.env` only when one exists, and never lets it override a real
# environment variable — so a stray `.env` cannot shadow Render's key.
#
# ---------------------------------------------------------------------------

# Get one at https://openrouter.ai/keys
#
# Make it a key used by nothing else, and SET A CREDIT LIMIT ON IT. The limit is
# the only control that is enforced by OpenRouter rather than by this code, and
# it is what makes the worst case a refused request instead of a bill.
#
# Leave this empty and the AI button is simply switched off. Everything else in
# the app works exactly as before.
OPENROUTER_API_KEY=

# Which model writes the book.
#
# `openrouter/free` is a router, not a model: it picks from whatever free models
# are available at the moment and filters them down to the ones that support what
# the request needs — here, structured JSON output. That is deliberate. It costs
# nothing, and it does not need editing when an individual free model is retired
# or renamed.
#
# A specific model works too, as long as it ends in `:free` while
# OPENROUTER_FREE_ONLY is 1. For example:
#   OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_MODEL=openrouter/free

# Refuse, before any request is made, to use a model that could be charged for.
#
# Leave this at 1. It turns a mistyped model name into a message on the page
# instead of a charge on the account. Set it to 0 only if you have deliberately
# chosen to spend money, and only with a credit limit set on the key.
OPENROUTER_FREE_ONLY=1

# Sent to OpenRouter as the X-Title header, which is what their dashboard labels
# this app's traffic with. It identifies the app, never the visitor.
OPENROUTER_APP_TITLE=Bookbinding Signature Creator

# Seconds one request may take before it is given up on.
AI_CALL_TIMEOUT_SECONDS=90

# Seconds a whole book may take. A book is one outline request plus one request
# per chapter, so this is the cap that stops a slow free model holding a session
# open indefinitely. Reaching it keeps the chapters already written.
AI_TOTAL_BUDGET_SECONDS=420

# The most chapters that will be asked for, whatever the description says.
# Each chapter is one more request against a rate-limited free tier.
AI_MAX_CHAPTERS=10
