# Settings for "Generate book for printing with AI". Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is git-ignored and docker-ignored. It is for running the app on your own
# machine and nothing else.
#
# ---------------------------------------------------------------------------
# On Render, there is no `.env` file at all.
# ---------------------------------------------------------------------------
# Render builds the image from the public repository, so anything committed is
# public. The key therefore never goes near the repository. Instead:
#
#   Render dashboard -> your service -> Environment -> Add Environment Variable
#       Key:   OPENROUTER_API_KEY
#       Value: sk-or-v1-...
#
# Render injects it into the container's environment at run time, separately
# from the git pull, and `os.environ` already holds it before the app starts.
# Put it in "Environment Variables", never in a Docker build argument: build
# arguments are recorded in the image history and can be read back out.
#
# The app reads a `.env` only when one exists, and never lets it override a real
# environment variable — so a stray `.env` cannot shadow Render's key.
#
# ---------------------------------------------------------------------------

# Get one at https://openrouter.ai/keys
#
# Make it a key used by nothing else, and SET A CREDIT LIMIT ON IT. The limit is
# the only control that is enforced by OpenRouter rather than by this code, and
# it is what makes the worst case a refused request instead of a bill.
#
# Leave this empty and the AI button is simply switched off. Everything else in
# the app works exactly as before.
OPENROUTER_API_KEY=

# Which model writes the book.
#
# Meta: Llama 3.1 8B Instruct. One model, named, the same one every time. Small
# and quick is the point — the app's problem was the length of the wait, not the
# quality of the prose.
#
# Which of the providers serving it answers is left to OpenRouter. There is no
# `provider` block in the request; its own routing already leans hard on cost.
#
# It is not free, but it is close: $0.02 per million tokens in, $0.04 out, so a
# whole book is a small fraction of a penny. SET A CREDIT LIMIT ON THE KEY. That
# limit is the ceiling, and it is the only one OpenRouter enforces for you.
#
# `openrouter/free` still works if you would rather spend nothing — it is a
# router that picks from whatever free models exist at the moment and filters
# them to the ones that can do structured JSON. So does any specific model:
#   OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Refuse, before any request is made, to use a model that could be charged for.
#
# Off, because the model above is a paid one — with this at 1 and that model set,
# every press of the button comes back refused.
#
# Set it to 1 on a copy that must not be able to spend anything at all, and set
# OPENROUTER_MODEL to `openrouter/free` or a `:free` model to go with it. Then a
# model name that could be charged for is a message on the page instead.
OPENROUTER_FREE_ONLY=0

# Sent to OpenRouter as the X-Title header, which is what their dashboard labels
# this app's traffic with. It identifies the app, never the visitor.
OPENROUTER_APP_TITLE=Bookbinding Signature Creator

# Show the book on screen as it is written, rather than all at once at the end.
#
# It does not make the model any quicker; it makes the waiting readable, which is
# most of what "slow" meant here. Set it to 0 only to rule streaming out while
# chasing a fault — the book itself is identical either way.
AI_STREAM=1

# Every token one book may cost, input and output, first request to last.
#
# A ceiling that is kept rather than hoped for. Each request carries a
# `max_tokens` the service enforces, the input is measured before it is sent,
# and a request whose worst case will not fit is not made at all — the chapters
# it would have written come from the outline instead, which costs nothing.
#
# So lowering this gives a shorter book. It cannot give a broken one, and it
# cannot give an error.
AI_TOKEN_LIMIT=5000

# Seconds one request may take before it is given up on.
AI_CALL_TIMEOUT_SECONDS=90

# Seconds a whole book may take, start to finish. The cap that stops a slow
# model holding a session open indefinitely. Reaching it stops the app asking
# for more chapters; the ones not written yet come from the outline.
AI_TOTAL_BUDGET_SECONDS=420

# How many chapters every book has. Exactly this many, not "up to".
#
# It is fixed on purpose. Left to choose, a model reads "a short novel" as a
# tone rather than as a number — one such description came back with twice the
# chapters of a request that had asked for a full-length novel. The number is
# put in the JSON schema, checked again afterwards, and printed on the button,
# so what the button promises is what arrives.
AI_CHAPTERS=5

# The most requests one book may cost, counting every retry.
#
# One request per chapter spent six on a five-chapter book; batching the
# chapters into whatever calls are left after the outline brings that to three.
# On a copy set to a free model it also matters that OpenRouter rations the free
# tier at roughly 50 requests a day, shared by everyone using this copy.
#
# Raising it means more, smaller batches — better prose, more waiting. It does
# NOT mean more tokens: AI_TOKEN_LIMIT above is a separate budget and it is the
# one that binds. Lowering this to 2 puts all five chapters in one reply, which
# a small model will often cut short.
AI_MAX_CALLS_PER_BOOK=3
